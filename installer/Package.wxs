<?xml version="1.0" encoding="utf-8"?>
<!--
  FileCommand MSI package (WiX v4/v5).

  This is a *dual-scope* package: it installs per-user (no elevation) by
  default, or per-machine (elevated) when the installing context requests
  it. See openspec/changes/wix-installer/design.md, decisions D1-D3.

  This MSI is designed to be driven by the Burn bootstrapper in
  Bundle.wxs, which supplies the setup UI. Running Package.msi directly
  installs with WiX's reduced/basic UI (no dialogs) — that is intentional,
  not an oversight; end users are expected to run FileCommandSetup.exe.

  Build-time variables (see installer/build.ps1):
    ProductVersion  - stamped from the Cargo workspace version, e.g. 0.1.0
    SourceDir       - directory containing the built filecommand.exe
                       (target/release)
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="FileCommand"
    Manufacturer="BigHatGroup"
    Version="$(var.ProductVersion)"
    UpgradeCode="E4FA877A-C5DE-4BB5-A56E-530939D32718"
    Language="1033"
    Codepage="1252"
    Scope="perUserOrMachine"
    InstallerVersion="500">

    <SummaryInformation Description="FileCommand Setup" Manufacturer="BigHatGroup" />

    <!--
      Same-scope, in-place upgrades only (design D5, D2 risk note): a newer
      MSI with the same UpgradeCode replaces an older install at the SAME
      scope. Switching scope (per-user <-> per-machine) is documented in
      README.md as uninstall-then-reinstall, not an upgrade path.
    -->
    <MajorUpgrade
      DowngradeErrorMessage="A newer version of [ProductName] is already installed. Setup will now exit." />

    <MediaTemplate EmbedCab="yes" />

    <Property Id="ARPURLINFOABOUT" Value="https://github.com/example/filecommand" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <!--
      Directory tree. Only the per-user root (%LocalAppData%\Programs) is
      authored statically; the per-machine root (%ProgramFiles%) is applied
      at install time by overriding the APPLICATIONFOLDER property below.
      This is the standard WiX "dual-scope / WixUI_Advanced" pattern.
    -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="LocalAppDataProgramsFolder" Name="Programs">
        <Directory Id="ManufacturerFolderPerUser" Name="BigHatGroup">
          <Directory Id="APPLICATIONFOLDER" Name="FileCommand" />
        </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="BigHatGroup" />
    </StandardDirectory>

    <!--
      Dual-scope switch: when the install context is NOT per-user
      (MSIINSTALLPERUSER unset because ALLUSERS=1 was requested — see
      Bundle.wxs's MsiProperty forwarding), redirect APPLICATIONFOLDER to
      the per-machine root under %ProgramFiles%\BigHatGroup\FileCommand.
      Both roots satisfy the required "BigHatGroup\FileCommand" suffix.
      This mirrors WixUI_Advanced's WixSetDefaultPerMachineFolder action.
    -->
    <SetProperty
      Id="APPLICATIONFOLDER"
      Before="CostFinalize"
      Sequence="both"
      Value="[ProgramFilesFolder]BigHatGroup\FileCommand"
      Condition="MSIINSTALLPERUSER &lt;&gt; 1" />

    <!-- Application binary -->
    <Component Id="ApplicationExecutable" Directory="APPLICATIONFOLDER" Guid="*">
      <File Id="FileCommandExe" Source="$(var.SourceDir)\filecommand.exe" KeyPath="yes" />
      <RemoveFolder Id="RemoveApplicationFolder" Directory="APPLICATIONFOLDER" On="uninstall" />
    </Component>

    <!-- Start Menu shortcut. ProgramMenuFolder resolves per-user or all-users automatically based on install context. -->
    <Component Id="ApplicationShortcut" Directory="ApplicationProgramsFolder" Guid="*">
      <Shortcut
        Id="ApplicationStartMenuShortcut"
        Name="FileCommand"
        Description="Keyboard-driven dual-panel file manager"
        Target="[APPLICATIONFOLDER]filecommand.exe"
        WorkingDirectory="APPLICATIONFOLDER" />
      <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
      <!--
        HKMU is the standard MSI root for dual-scope packages: it resolves
        to HKCU when installing per-user and HKLM when installing
        per-machine, matching whichever scope this component actually
        installed under.
      -->
      <RegistryValue Root="HKMU" Key="Software\BigHatGroup\FileCommand" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <!--
      PATH integration (design D3): append the install directory to PATH
      at the matching scope, removed automatically on uninstall via the
      Environment table (Action="set" ... the MSI engine removes entries
      it added when the component is uninstalled). Two components, each
      gated to exactly one scope by MSIINSTALLPERUSER, because the
      Environment/@System attribute (user vs machine environment) must be
      fixed at author time.
    -->
    <Component Id="PathEnvUser" Directory="APPLICATIONFOLDER" Guid="*" Condition="MSIINSTALLPERUSER = 1">
      <Environment Id="PATH_USER" Name="PATH" Value="[APPLICATIONFOLDER]" Permanent="no" Part="last" Action="set" System="no" />
      <RegistryValue Root="HKCU" Key="Software\BigHatGroup\FileCommand" Name="PathEnvUser" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Component Id="PathEnvMachine" Directory="APPLICATIONFOLDER" Guid="*" Condition="MSIINSTALLPERUSER &lt;&gt; 1">
      <Environment Id="PATH_MACHINE" Name="PATH" Value="[APPLICATIONFOLDER]" Permanent="no" Part="last" Action="set" System="yes" />
      <RegistryValue Root="HKLM" Key="Software\BigHatGroup\FileCommand" Name="PathEnvMachine" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Feature Id="MainApplication" Title="FileCommand" Level="1" AllowAbsent="no">
      <ComponentRef Id="ApplicationExecutable" />
      <ComponentRef Id="ApplicationShortcut" />
      <ComponentRef Id="PathEnvUser" />
      <ComponentRef Id="PathEnvMachine" />
    </Feature>

  </Package>
</Wix>
